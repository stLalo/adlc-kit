# Machine-local kit settings: lives at <kit>/.adlc/kit.env and is never committed.
# The kit scripts read these only from this file, never from the caller's environment.

# Branches nobody pushes to directly. A repo's MAIN_BRANCH must be one of them.
ADLC_PROTECTED_BRANCHES="main master develop"

# Who the agent acts as on the code host.
#   own-login   the login you already have on the host CLI and git (default)
#   github-app  a GitHub App bot: pushes, comments and statuses come from the bot, not from you
IDENTITY_ADAPTER="own-login"

# Where an identity adapter reads its secrets (adapters/secrets/): env | command
SECRETS_ADAPTER="env"
SECRET_CMD=""                       # for "command": e.g. "op read", "vault kv get -field=value", "pass show"

# github-app identity: references the secrets adapter understands (never the secrets themselves).
ADLC_APP_CLIENT_ID_REF=""
ADLC_APP_INSTALLATION_ID_REF=""
ADLC_APP_PRIVATE_KEY_REF=""
ADLC_GITHUB_API="https://api.github.com"

# Regex of command lines that would read the agent's credentials directly; the guard blocks them.
# e.g. "op (read|item get).*adlc-bot"
SECRET_BLOCK_PATTERNS=""

# Optional: a command that tells you something needs you. It gets the message as its only argument.
NOTIFY_CMD=""
