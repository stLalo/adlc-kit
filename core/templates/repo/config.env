# ADLC kit config for this repo. Edited by the owner only (the guard blocks agent edits), through a PR.
# The kit scripts always read the copy merged on MAIN_BRANCH, never a branch's own copy.
# Plain KEY="value" lines.

MAIN_BRANCH="main"                  # must be listed in ADLC_PROTECTED_BRANCHES in the kit's kit.env

# Adapters (folders under the kit's adapters/). See docs/adapting.md.
HOST_ADAPTER=""                     # where pull requests live                 (adapters/host/*.sh)
SPEC_ADAPTER=""                     # how specs are written                     (adapters/spec/*.env)
JUDGE_ADAPTER=""                    # who reviews: a judge adapter (adapters/judge/*.sh), or "human":
                                    # an approving review from a repo admin is the verdict

# Judge
JUDGE_MODEL=""                      # exact model id the judge CLI accepts; empty = that CLI's default
JUDGE_FALLBACK_MODEL=""             # tried once if the first model fails
MAX_JUDGE_ROUNDS="3"

# Roles: which model does which job. Free text shown to the agent; a harness may also use it
# (Claude Code: the model of the generated subagents). Empty = any model.
ROLE_PLANNER=""                     # writes intent, spec, plan and the build prompt      e.g. your strongest model
ROLE_BUILDER=""                     # implements from the build prompt                    e.g. a fast, cheaper model
ROLE_RELEASER=""                    # final check before merge, prod approval             e.g. your strongest model
ROLE_CRITIC_DEEP=""                 # second critique of high-risk intents                e.g. your strongest model

# How agent-merge.sh merges: merge (keeps checkpoint ancestry) or squash. The host must allow it.
MERGE_METHOD="merge"

# Local stand-in for CI: must pass before merge. Runs without the agent's host token.
TEST_CMD="make test"

# UAT
UAT_DEPLOY_CMD=""                   # e.g. "./deploy/uat.sh"   (receives REF env var)
UAT_TEST_CMD=""                     # regression/integration suite against UAT. Empty = prod is blocked.

# Prod
PROD_DEPLOY_CMD=""                  # e.g. "./deploy/prod.sh"  (receives REF env var)
ROLLBACK_CMD=""                     # e.g. "./deploy/prod.sh --rollback". Empty = prod is blocked.
PROD_SMOKE_CMD=""                   # optional quick check after prod deploy; failure triggers rollback

# Extra shell patterns the guard must block when an agent runs them directly (regex, | separated)
DEPLOY_BLOCK_PATTERNS="deploy/uat\.sh|deploy/prod\.sh|kubectl (apply|rollout)|helm (upgrade|install)"
