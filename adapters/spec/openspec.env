# Spec adapter: OpenSpec (https://github.com/Fission-AI/OpenSpec). Status: tested by maintainers.
# Sourced by core/scripts/lib.sh after the repo config. Contract: adapters/spec/CONTRACT.md.

SPEC_CHANGES_DIR="openspec/changes"                       # one folder per change: <dir>/<change-id>/
SPEC_ARCHIVE_RE="archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-"     # prefix of an archived change folder (regex)
SPEC_SPECS_DIR="openspec/specs"                           # current specs the archive step syncs into
DOCS_PATHS="openspec docs"                                # top-level folders a docs-only PR may touch

# Hints the playbooks show to the agent ({change} is replaced by the change id).
SPEC_INIT_HINT="openspec init"
SPEC_PROPOSE_HINT="the OpenSpec propose step for {change} (in Claude Code: /opsx:propose {change})"
SPEC_VALIDATE_CMD="openspec validate {change} --strict"
SPEC_ARCHIVE_HINT="the OpenSpec archive step for {change} (in Claude Code: /opsx:archive {change}; CLI: openspec archive {change} --yes)"
