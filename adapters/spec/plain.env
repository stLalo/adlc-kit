# Spec adapter: plain markdown, no spec tool. Status: tested by maintainers (offline suite).
# Sourced by core/scripts/lib.sh after the repo config. Contract: adapters/spec/CONTRACT.md.
#
# A change is a folder docs/changes/<change-id>/ holding intent.md, proposal.md, spec.md (acceptance
# criteria), design.md, tasks.md and BUILD_PROMPT.md. Archiving = moving the folder to
# docs/changes/archive/<YYYY-MM-DD>-<change-id>/ and copying the accepted behaviour into docs/specs/.

SPEC_CHANGES_DIR="docs/changes"
SPEC_ARCHIVE_RE="archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-"
SPEC_SPECS_DIR="docs/specs"
DOCS_PATHS="docs"

SPEC_INIT_HINT="mkdir -p docs/changes docs/specs"
SPEC_PROPOSE_HINT="write proposal.md, spec.md, design.md and tasks.md in docs/changes/{change}/"
SPEC_VALIDATE_CMD=""
SPEC_ARCHIVE_HINT="git mv docs/changes/{change} docs/changes/archive/\$(date +%F)-{change}, then update docs/specs/ to the accepted behaviour"
